(footprint "Relay_JW1FSN_QT" (version 20221018) (generator pcbnew)
  (layer "F.Cu")
  (descr "Panasonic JW1FSN 1 Form C (reused from original QTech board), rotated so coil pins are at y=0. QTech pin map: 1/2 coil, 3=COM, 4=NO, 5=NC. Pattern from KiCad Relay_SPDT_Panasonic_JW1_FormC. VERIFY NO/NC with a meter.")
  (tags "Panasonic JW1 relay SPDT")
  (attr through_hole)
  (fp_text reference "REF**" (at 11.6 11.6 90) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
  (fp_text value "Relay_JW1FSN_QT" (at -4.0 11.6 90) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))
  (fp_rect (start -2.6 -2.7) (end 10.2 25.9) (stroke (width 0.1) (type solid)) (fill none) (layer "F.Fab"))
  (fp_rect (start -2.72 -2.82) (end 10.32 26.02) (stroke (width 0.12) (type solid)) (fill none) (layer "F.SilkS"))
  (fp_rect (start -3.0 -3.1) (end 10.6 26.3) (stroke (width 0.05) (type solid)) (fill none) (layer "F.CrtYd"))
  (fp_line (start -2.72 3.0) (end 10.32 3.0) (stroke (width 0.12) (type solid)) (layer "F.SilkS"))
  (fp_text user "COIL" (at 3.8 1.6) (layer "F.Fab") (effects (font (size 0.8 0.8) (thickness 0.12))))
  (pad "1" thru_hole rect (at 0 0) (size 2.0 2.0) (drill 1.3) (layers "*.Cu" "*.Mask"))
  (pad "2" thru_hole circle (at 7.6 0) (size 2.2 2.2) (drill 1.3) (layers "*.Cu" "*.Mask"))
  (pad "3" thru_hole circle (at 7.6 20.0) (size 2.5 2.5) (drill 1.4) (layers "*.Cu" "*.Mask"))
  (pad "4" thru_hole circle (at 0 23.5) (size 2.5 2.5) (drill 1.4) (layers "*.Cu" "*.Mask"))
  (pad "5" thru_hole circle (at 0 16.5) (size 2.5 2.5) (drill 1.4) (layers "*.Cu" "*.Mask"))
  (model "${KICAD10_3DMODEL_DIR}/Relay_THT.3dshapes/Relay_SPDT_Panasonic_JW1_FormC.step" (offset (xyz 0 0 0)) (scale (xyz 1 1 1)) (rotate (xyz 0 0 -90)))
