(version 1)
(rule "mains to low voltage (reinforced, 6.5mm)"
  (constraint clearance (min 6.5mm))
  (condition "(A.NetName == 'LIVE' || A.NetName == 'LIVE_SW' || A.NetName == 'NEUT' || A.NetName == 'MOTOR_L' || A.NetName == 'COMP_OUT' || A.NetName == 'PUMP_OUT' || A.NetName == 'FAN_OUT' || A.NetName == 'HOUT' || A.NetName == 'HEATER_L' || A.NetName == 'L_FILT' || A.NetName == 'N_FILT' || A.NetName == 'N_F1.1' || A.NetName == 'N_TR1.3' || A.NetName == 'VALVE_L' || A.NetName == 'VOUT1' || A.NetName == 'VOUT2' || A.NetName == 'VOUT3' || A.NetName == 'VOUT4' || A.NetName == 'VOUT5' || A.NetName == 'VOUT6' || A.NetName == 'VOUT7' || A.NetName == 'VOUT8' || A.NetName == 'VOUT9' || A.NetName == 'VOUT10' || A.NetName == 'N_K1.5' || A.NetName == 'N_K11.5' || A.NetName == 'N_K13.5' || A.NetName == 'N_K14.5' || A.NetName == 'N_K15.5' || A.NetName == 'N_K2.5' || A.NetName == 'N_K3.5' || A.NetName == 'N_K4.5' || A.NetName == 'N_K5.5' || A.NetName == 'N_K6.5' || A.NetName == 'N_K7.5' || A.NetName == 'N_K8.5') && !(B.NetName == 'LIVE' || B.NetName == 'LIVE_SW' || B.NetName == 'NEUT' || B.NetName == 'MOTOR_L' || B.NetName == 'COMP_OUT' || B.NetName == 'PUMP_OUT' || B.NetName == 'FAN_OUT' || B.NetName == 'HOUT' || B.NetName == 'HEATER_L' || B.NetName == 'L_FILT' || B.NetName == 'N_FILT' || B.NetName == 'N_F1.1' || B.NetName == 'N_TR1.3' || B.NetName == 'VALVE_L' || B.NetName == 'VOUT1' || B.NetName == 'VOUT2' || B.NetName == 'VOUT3' || B.NetName == 'VOUT4' || B.NetName == 'VOUT5' || B.NetName == 'VOUT6' || B.NetName == 'VOUT7' || B.NetName == 'VOUT8' || B.NetName == 'VOUT9' || B.NetName == 'VOUT10' || B.NetName == 'N_K1.5' || B.NetName == 'N_K11.5' || B.NetName == 'N_K13.5' || B.NetName == 'N_K14.5' || B.NetName == 'N_K15.5' || B.NetName == 'N_K2.5' || B.NetName == 'N_K3.5' || B.NetName == 'N_K4.5' || B.NetName == 'N_K5.5' || B.NetName == 'N_K6.5' || B.NetName == 'N_K7.5' || B.NetName == 'N_K8.5') && !(B.NetName == 'PE')"))
(rule "mains to mains / PE (2.5mm)"
  (constraint clearance (min 2.5mm))
  (condition "(A.NetName == 'LIVE' || A.NetName == 'LIVE_SW' || A.NetName == 'NEUT' || A.NetName == 'MOTOR_L' || A.NetName == 'COMP_OUT' || A.NetName == 'PUMP_OUT' || A.NetName == 'FAN_OUT' || A.NetName == 'HOUT' || A.NetName == 'HEATER_L' || A.NetName == 'L_FILT' || A.NetName == 'N_FILT' || A.NetName == 'N_F1.1' || A.NetName == 'N_TR1.3' || A.NetName == 'VALVE_L' || A.NetName == 'VOUT1' || A.NetName == 'VOUT2' || A.NetName == 'VOUT3' || A.NetName == 'VOUT4' || A.NetName == 'VOUT5' || A.NetName == 'VOUT6' || A.NetName == 'VOUT7' || A.NetName == 'VOUT8' || A.NetName == 'VOUT9' || A.NetName == 'VOUT10' || A.NetName == 'N_K1.5' || A.NetName == 'N_K11.5' || A.NetName == 'N_K13.5' || A.NetName == 'N_K14.5' || A.NetName == 'N_K15.5' || A.NetName == 'N_K2.5' || A.NetName == 'N_K3.5' || A.NetName == 'N_K4.5' || A.NetName == 'N_K5.5' || A.NetName == 'N_K6.5' || A.NetName == 'N_K7.5' || A.NetName == 'N_K8.5') && ((B.NetName == 'LIVE' || B.NetName == 'LIVE_SW' || B.NetName == 'NEUT' || B.NetName == 'MOTOR_L' || B.NetName == 'COMP_OUT' || B.NetName == 'PUMP_OUT' || B.NetName == 'FAN_OUT' || B.NetName == 'HOUT' || B.NetName == 'HEATER_L' || B.NetName == 'L_FILT' || B.NetName == 'N_FILT' || B.NetName == 'N_F1.1' || B.NetName == 'N_TR1.3' || B.NetName == 'VALVE_L' || B.NetName == 'VOUT1' || B.NetName == 'VOUT2' || B.NetName == 'VOUT3' || B.NetName == 'VOUT4' || B.NetName == 'VOUT5' || B.NetName == 'VOUT6' || B.NetName == 'VOUT7' || B.NetName == 'VOUT8' || B.NetName == 'VOUT9' || B.NetName == 'VOUT10' || B.NetName == 'N_K1.5' || B.NetName == 'N_K11.5' || B.NetName == 'N_K13.5' || B.NetName == 'N_K14.5' || B.NetName == 'N_K15.5' || B.NetName == 'N_K2.5' || B.NetName == 'N_K3.5' || B.NetName == 'N_K4.5' || B.NetName == 'N_K5.5' || B.NetName == 'N_K6.5' || B.NetName == 'N_K7.5' || B.NetName == 'N_K8.5') || (B.NetName == 'PE'))"))
(rule "mains hole clearance"
  (constraint hole_clearance (min 2.5mm))
  (condition "(A.NetName == 'LIVE' || A.NetName == 'LIVE_SW' || A.NetName == 'NEUT' || A.NetName == 'MOTOR_L' || A.NetName == 'COMP_OUT' || A.NetName == 'PUMP_OUT' || A.NetName == 'FAN_OUT' || A.NetName == 'HOUT' || A.NetName == 'HEATER_L' || A.NetName == 'L_FILT' || A.NetName == 'N_FILT' || A.NetName == 'N_F1.1' || A.NetName == 'N_TR1.3' || A.NetName == 'VALVE_L' || A.NetName == 'VOUT1' || A.NetName == 'VOUT2' || A.NetName == 'VOUT3' || A.NetName == 'VOUT4' || A.NetName == 'VOUT5' || A.NetName == 'VOUT6' || A.NetName == 'VOUT7' || A.NetName == 'VOUT8' || A.NetName == 'VOUT9' || A.NetName == 'VOUT10' || A.NetName == 'N_K1.5' || A.NetName == 'N_K11.5' || A.NetName == 'N_K13.5' || A.NetName == 'N_K14.5' || A.NetName == 'N_K15.5' || A.NetName == 'N_K2.5' || A.NetName == 'N_K3.5' || A.NetName == 'N_K4.5' || A.NetName == 'N_K5.5' || A.NetName == 'N_K6.5' || A.NetName == 'N_K7.5' || A.NetName == 'N_K8.5')"))
(rule "mains edge clearance"
  (constraint edge_clearance (min 1.5mm))
  (condition "(A.NetName == 'LIVE' || A.NetName == 'LIVE_SW' || A.NetName == 'NEUT' || A.NetName == 'MOTOR_L' || A.NetName == 'COMP_OUT' || A.NetName == 'PUMP_OUT' || A.NetName == 'FAN_OUT' || A.NetName == 'HOUT' || A.NetName == 'HEATER_L' || A.NetName == 'L_FILT' || A.NetName == 'N_FILT' || A.NetName == 'N_F1.1' || A.NetName == 'N_TR1.3' || A.NetName == 'VALVE_L' || A.NetName == 'VOUT1' || A.NetName == 'VOUT2' || A.NetName == 'VOUT3' || A.NetName == 'VOUT4' || A.NetName == 'VOUT5' || A.NetName == 'VOUT6' || A.NetName == 'VOUT7' || A.NetName == 'VOUT8' || A.NetName == 'VOUT9' || A.NetName == 'VOUT10' || A.NetName == 'N_K1.5' || A.NetName == 'N_K11.5' || A.NetName == 'N_K13.5' || A.NetName == 'N_K14.5' || A.NetName == 'N_K15.5' || A.NetName == 'N_K2.5' || A.NetName == 'N_K3.5' || A.NetName == 'N_K4.5' || A.NetName == 'N_K5.5' || A.NetName == 'N_K6.5' || A.NetName == 'N_K7.5' || A.NetName == 'N_K8.5')"))
(rule "heavy mains track width"
  (constraint track_width (min 1.9mm))
  (condition "(A.NetName == 'LIVE' || A.NetName == 'LIVE_SW' || A.NetName == 'NEUT' || A.NetName == 'MOTOR_L' || A.NetName == 'COMP_OUT' || A.NetName == 'PUMP_OUT')"))
(rule "mains track width"
  (constraint track_width (min 1.4mm))
  (condition "(A.NetName == 'FAN_OUT' || A.NetName == 'HOUT' || A.NetName == 'HEATER_L' || A.NetName == 'L_FILT' || A.NetName == 'N_FILT' || A.NetName == 'N_F1.1' || A.NetName == 'N_TR1.3' || A.NetName == 'VALVE_L' || A.NetName == 'VOUT1' || A.NetName == 'VOUT2' || A.NetName == 'VOUT3' || A.NetName == 'VOUT4' || A.NetName == 'VOUT5' || A.NetName == 'VOUT6' || A.NetName == 'VOUT7' || A.NetName == 'VOUT8' || A.NetName == 'VOUT9' || A.NetName == 'VOUT10' || A.NetName == 'N_K1.5' || A.NetName == 'N_K11.5' || A.NetName == 'N_K13.5' || A.NetName == 'N_K14.5' || A.NetName == 'N_K15.5' || A.NetName == 'N_K2.5' || A.NetName == 'N_K3.5' || A.NetName == 'N_K4.5' || A.NetName == 'N_K5.5' || A.NetName == 'N_K6.5' || A.NetName == 'N_K7.5' || A.NetName == 'N_K8.5')"))
